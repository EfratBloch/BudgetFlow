<?xml version="1.0" encoding="utf-8" ?>
<!--
  NLog: where log messages go.
  - logs/yyyy-MM-dd.log : one file per day in the API project folder (the logs folder is git-ignored)
  - console             : the black window while the server runs
  Every line shows the request's CorrelationId (from CorrelationIdMiddleware), or "-" outside a request.
  internalLogLevel="Warn" makes NLog report its own problems (e.g. a folder it cannot write to).
-->
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      internalLogLevel="Warn">

  <extensions>
    <add assembly="NLog.Web.AspNetCore" />
  </extensions>

  <targets>
    <!-- Keeps the last 14 days; older files are deleted automatically -->
    <target xsi:type="File" name="file"
            fileName="${aspnet-appbasepath}/logs/${shortdate}.log"
            maxArchiveDays="14"
            layout="${longdate} | ${level:uppercase=true:padding=-5} | ${scopeproperty:CorrelationId:whenEmpty=-} | ${logger:shortName=true} | ${message} ${exception:format=tostring}" />

    <target xsi:type="Console" name="console"
            layout="${time} | ${level:uppercase=true:padding=-5} | ${scopeproperty:CorrelationId:whenEmpty=-} | ${message} ${exception:format=message}" />
  </targets>

  <rules>
    <!-- The lines that say the server started and on which address (before the filter below) -->
    <logger name="Microsoft.Hosting.Lifetime" minlevel="Info" writeTo="file,console" final="true" />

    <!-- Framework noise: from Microsoft.* and System.* only warnings and errors get through -->
    <logger name="Microsoft.*" maxlevel="Info" final="true" />
    <logger name="System.Net.Http.*" maxlevel="Info" final="true" />

    <!-- Everything else (our code) from Info up -->
    <logger name="*" minlevel="Info" writeTo="file,console" />
  </rules>
</nlog>
